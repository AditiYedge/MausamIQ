# MausamIQ Environment Configuration Template
# Copy to .env for local runtime overrides. NEVER commit production secrets.

# Application Environment: 'development' | 'testing' | 'production'
APP_ENV=development
DEBUG=true
APP_NAME=MausamIQ
APP_VERSION=1.0.0

# Server Binding
HOST=127.0.0.1
PORT=8000

# Security (Set strong random key for production session/token encryption)
SECRET_KEY=dev_secret_key_change_in_production_9a8b7c6d5e4f3a2b1c

# Database Connection
# SQLite for default zero-friction local execution:
DATABASE_URL=sqlite:///./app/db/mausamiq.db
# PostgreSQL for production deployment:
# DATABASE_URL=postgresql://mausamiq_user:strong_password@localhost:5432/mausamiq_db

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Default Reference Baseline Period: '1981-2010' or '1991-2020'
DEFAULT_BASELINE_PERIOD=1981-2010
